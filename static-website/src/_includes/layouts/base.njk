<!DOCTYPE html>
<html lang="de">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>
			{%- if title -%}
				{{ title }} – {{ site.name }}
			{%- else -%}
				{{ site.name }}
			{%- endif -%}
		</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Roboto+Slab:wght@500;700&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="/css/site.css">
		<link rel="icon" href="/assets/hzd-logo.webp" type="image/png">
	</head>
	<body>
		<header class="site-header">
			<div class="header-bar">
				<a class="logo" href="/" aria-label="Zur Startseite">
					<img
						src="/assets/hzd-logo.webp"
						alt="HZD-Logo"
						width="140"
						height="140"
					>
				</a>
				<nav class="site-nav" aria-label="Hauptnavigation">
					{% for item in navigation %}
						<a
							href="{{ item.url }}"
							{% if page.url == item.url %}aria-current="page"{% endif %}
						>{{ item.label }}</a>
					{% endfor %}
				</nav>
			</div>
		</header>

		<main class="content">
			{{ content | safe }}
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<a class="footer-logo" href="/" aria-label="Zur Startseite">
					<img
						src="/assets/hzd-logo.webp"
						alt=""
						width="96"
						height="96"
					>
				</a>
				<div class="footer-contact">
					<p class="footer-label">Präsidentin</p>
					<p>Claudia von Brill</p>
					<p>Blumenweg 2</p>
					<p>85551 Kirchheim</p>
				</div>
				<div class="footer-links">
					<p class="footer-label">Kontakt</p>
					<p>
						<a href="mailto:praesident.hzd@hovawarte.com">
							praesident.hzd@hovawarte.com
						</a>
					</p>
					<p><a href="/impressum/">Impressum</a></p>
				</div>
			</div>
			<p class="copyright">
				© {{ site.year }} {{ site.name }}
			</p>
		</footer>
	</body>
</html>
