{
  "kind": "collectionType",
  "collectionName": "advent_calendars",
  "info": {
    "singularName": "advent-calendar",
    "pluralName": "advent-calendars",
    "displayName": "AdventCalendar"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Description": {
      "type": "string"
    },
    "AdventDay": {
      "type": "component",
      "component": "blocks.advent-day",
      "repeatable": true
    },
    "Hintergrundfarbe": {
      "type": "customField",
      "customField": "plugin::color-picker.color",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
    },
    "Ankuendigung": {
      "type": "blocks"
    },
    "KalenderPlatzhalter": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
