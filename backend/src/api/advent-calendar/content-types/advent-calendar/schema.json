{
  "kind": "collectionType",
  "collectionName": "advent_calendars",
  "info": {
    "singularName": "advent-calendar",
    "pluralName": "advent-calendars",
    "displayName": "AdventCalendar"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Description": {
      "type": "string"
    },
    "AdventDay": {
      "type": "component",
      "component": "blocks.advent-day",
      "repeatable": true
    },
    "Hintergrundfarbe": {
      "type": "customField",
      "customField": "plugin::color-picker.color",
      "regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
    },
    "Ankuendigung": {
      "type": "blocks"
    },
    "KalenderPlatzhalter": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "SchlussGruesse": {
      "type": "blocks"
    },
    "SchlussBild": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "TageVorlauf": {
      "type": "integer",
      "required": true,
      "default": 10,
      "min": 0,
      "max": 30
    },
    "TageNachlauf": {
      "type": "integer",
      "required": true,
      "default": 14,
      "min": 2,
      "max": 30
    },
    "Jahr": {
      "type": "integer",
      "required": true,
      "min": 2026,
      "max": 2099
    },
    "KalenderPlatzhalterAiNote": {
      "type": "enumeration",
      "enum": [
        "AiGenerated",
        "AiModified"
      ]
    },
    "SchlussBildAiNote": {
      "type": "enumeration",
      "enum": [
        "AiGenerated",
        "AiModified"
      ]
    }
  }
}
