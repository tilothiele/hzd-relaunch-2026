{
  "kind": "collectionType",
  "collectionName": "passed_dogs",
  "info": {
    "singularName": "passed-dog",
    "pluralName": "passed-dogs",
    "displayName": "PassedDog"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "DatePassed": {
      "type": "date"
    },
    "Message": {
      "type": "text"
    },
    "Approved": {
      "type": "boolean",
      "default": false
    },
    "Avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "DogName": {
      "type": "string"
    },
    "Consent": {
      "type": "boolean"
    },
    "UserName": {
      "type": "string"
    },
    "EMail": {
      "type": "email"
    },
    "ClientIP": {
      "type": "string"
    },
    "HealthInfo": {
      "type": "text"
    }
  }
}
